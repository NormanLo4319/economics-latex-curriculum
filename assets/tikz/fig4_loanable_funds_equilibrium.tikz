% Figure 4: Loanable Funds Equilibrium
% Macroeconomics Chapter 6
% Coordinate graph showing supply and demand for loanable funds

\documentclass[tikz,border=5pt]{standalone}
\usepackage{pgfplots}
\pgfplotsset{compat=1.18}

% Define Okabe-Ito colorblind-safe palette
\definecolor{CourseBlue}{HTML}{0072B2}        % Demand, baseline (Deep Blue)
\definecolor{CourseOrange}{HTML}{D55E00}      % Supply (Vermilion-Orange)
\definecolor{CourseTeal}{HTML}{009E73}        % Secondary (Bluish-Green)
\definecolor{CoursePurple}{HTML}{CC79A7}      % Accent (Reddish-Purple)
\definecolor{CourseAmber}{HTML}{E69F00}       % Highlight (Warm Amber)
\definecolor{CourseSlate}{HTML}{1E293B}       % Axes, grids, labels (Dark Slate)

\begin{document}

\begin{tikzpicture}
  \begin{axis}[
    width=10cm,
    height=7cm,
    xmin=0, xmax=300,
    ymin=0, ymax=8,
    xlabel={Quantity of Loanable Funds (\$B)},
    ylabel={Real Interest Rate, $r$ (\%)},
    xlabel style={font=\small, color=CourseSlate},
    ylabel style={font=\small, color=CourseSlate},
    tick label style={font=\small, color=CourseSlate},
    axis line style={color=CourseSlate, line width=0.5pt},
    grid=major,
    grid style={solid, color=CourseSlate, opacity=0.4, line width=0.5pt},
    major grid style={dash pattern=on 1pt off 1pt},
    xtick={0, 50, 100, 150, 200, 250, 300},
    ytick={0, 1, 2, 3, 4, 5, 6, 7, 8},
    minor tick num=0,
    title={Loanable Funds Market Equilibrium},
    title style={font=\small\bfseries, color=CourseSlate},
    ]
    
    % Supply curve: r = 0.5 + 0.025Q
    % Points: (0, 0.5), (100, 3), (140, 4), (200, 5.5), (300, 8)
    \addplot[
      color=CourseOrange,
      line width=2pt,
      smooth,
      domain=0:300,
      samples=100
    ] {0.5 + 0.025*x};
    
    % Supply curve label (at endpoint, offset above)
    \node[color=CourseOrange, font=\small, anchor=west] at (300, 8.2) {
      Supply of Loanable Funds ($S$)
    };
    
    % Demand curve: r = 6.8 - 0.02Q
    % Points: (0, 6.8), (100, 4.8), (140, 4), (200, 2.8), (300, 0.8)
    \addplot[
      color=CourseBlue,
      line width=2pt,
      smooth,
      domain=0:300,
      samples=100
    ] {6.8 - 0.02*x};
    
    % Demand curve label (at endpoint, offset below)
    \node[color=CourseBlue, font=\small, anchor=west] at (300, 0.3) {
      Demand for Loanable Funds ($D$)
    };
    
    % Equilibrium point marker
    \addplot[color=CourseSlate, mark=*, mark size=4pt] coordinates {(140, 4)};
    
    % Vertical dashed guide line from equilibrium to x-axis
    \addplot[
      color=CourseSlate,
      line width=0.5pt,
      dash pattern=on 2pt off 2pt,
      forget plot
    ] coordinates {(140, 0) (140, 4)};
    
    % Horizontal dashed guide line from equilibrium to y-axis
    \addplot[
      color=CourseSlate,
      line width=0.5pt,
      dash pattern=on 2pt off 2pt,
      forget plot
    ] coordinates {(0, 4) (140, 4)};
    
  \end{axis}
  
  % Equilibrium label (above and to the right of the point)
  \node[
    color=CourseSlate,
    font=\small\bfseries,
    anchor=south west,
    xshift=5pt,
    yshift=5pt
  ] at (4.6, 5.86) {
    $E^* (Q^*=140\text{B}, r^*=4\%)$
  };
  
  % x-axis label for equilibrium quantity
  \node[
    color=CourseSlate,
    font=\small,
    anchor=north,
    yshift=-3pt
  ] at (4.6, -0.65) {
    $Q^*=140\text{B}$
  };
  
  % y-axis label for equilibrium rate
  \node[
    color=CourseSlate,
    font=\small,
    anchor=east,
    xshift=-3pt
  ] at (-0.4, 5.86) {
    $r^*=4\%$
  };
  
\end{tikzpicture}

\end{document}
